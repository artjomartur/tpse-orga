# NextAuth — zwingend für stabile Sessions (sonst „Abmeldung“ beim Seitenwechsel)
# Generieren z. B.: openssl rand -base64 32
NEXTAUTH_SECRET=

# Basis-URL der App (lokal)
NEXTAUTH_URL=http://localhost:3000

# Admin für prisma/seed.js
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Pflicht-Meilensteine (ISO 8601). Ohne Wert: Frist „nicht gesetzt“ in der UI.
# Beispiel: 2025-04-20T23:59:00+02:00
MILESTONE_DEADLINE_JOIN=
MILESTONE_DEADLINE_PROJECT_PREFERENCES=
MILESTONE_DEADLINE_SPEC=
