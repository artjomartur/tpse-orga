{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tpse-orga",
	"main": ".open-next/worker.js",
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"compatibility_date": "2024-09-23",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tpse-orga-db",
			"database_id": "417c67d4-6110-4426-8b88-54f09d7253ae"
		}
	],
	"r2_buckets": [
		{
			"binding": "PDF_BUCKET",
			"bucket_name": "tpse-orga-pdfs"
		}
	]
}