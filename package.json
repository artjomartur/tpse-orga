{
  "name": "tpse-orga",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "scripts": {
    "kill:3000": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true",
    "dev": "WATCHPACK_POLLING=true next dev -p 3000",
    "dev:clean": "rm -rf .next && WATCHPACK_POLLING=true next dev -p 3000",
    "dev:clean:kill": "npm run kill:3000 && rm -rf .next && WATCHPACK_POLLING=true next dev -p 3000",
    "dev:3001": "WATCHPACK_POLLING=true next dev -p 3001",
    "build": "prisma generate && opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion",
    "start": "next start -p 3000",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "deploy": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && opennextjs-cloudflare preview"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "autoprefixer": "^10.4.27",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "lucide-react": "^0.577.0",
    "next": "^14.2.35",
    "next-auth": "^4.24.13",
    "next-themes": "^0.4.6",
    "pdf-parse": "^1.1.1",
    "postcss": "^8.5.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.17.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.35",
    "prisma": "^6.19.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "wrangler": "^4.76.0"
  },
  "overrides": {
    "@opennextjs/cloudflare": {
      "next": "$next"
    },
    "@opennextjs/aws": {
      "next": "$next"
    }
  }
}
