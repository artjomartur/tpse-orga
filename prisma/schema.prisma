generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  role         String   @default("STUDENT")
  passwordHash String
  createdAt    DateTime @default(now())

  teamMembers TeamMember[]
  submissions Submission[] @relation("SubmissionSubmittedBy")
  grades      Grade[]      @relation("GradeGradedBy")

  scheduleItems ScheduleItem[] @relation("ScheduleItemCreatedBy")
  announcements Announcement[] @relation("AnnouncementCreatedBy")
  resources     Resource[]     @relation("ResourceCreatedBy")

  studentTodos    StudentTodo[]
  teamSpecUploads TeamSpecDocument[] @relation("TeamSpecUploadedBy")

  hiwiActivities HiwiActivity[]
  hiwiTodos      HiwiTodo[]
  pdfAnnotations PdfAnnotation[]
  studentAssignments StudentAssignment[]
}

model Team {
  id          String   @id @default(cuid())
  name        String
  projectName String?
  maxMembers  Int      @default(5)
  createdAt   DateTime @default(now())

  members     TeamMember[]
  submissions Submission[]

  projectChoices TeamProjectChoice[]
  specDocument   TeamSpecDocument?
}

/// Verfügbare Projekte (Katalog für Präferenzen)
model Project {
  id          String  @id @default(cuid())
  title       String
  description String?
  sortOrder   Int     @default(0)

  teamChoices TeamProjectChoice[]
}

/// Pro Team: 5 Favoriten (Platz 1–5) und 5 „Nieten“ (Platz 1–5)
model TeamProjectChoice {
  id        String @id @default(cuid())
  teamId    String
  projectId String
  kind      String // "FAVORITE" | "NIE"
  slot      Int // 1..5

  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([teamId, kind, slot])
  @@unique([teamId, projectId])
}

model StudentTodo {
  id        String   @id @default(cuid())
  userId    String
  title     String
  done      Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sortOrder])
}

/// Eine Spezifikation pro Team (PDF → extrahierter Text)
model TeamSpecDocument {
  id            String   @id @default(cuid())
  teamId        String   @unique
  fileName      String
  filePath      String
  mimeType      String
  extractedText String?
  uploadedAt    DateTime @default(now())
  uploadedById  String?

  team       Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation("TeamSpecUploadedBy", fields: [uploadedById], references: [id])
  annotations PdfAnnotation[]
}

model TeamMember {
  id     String @id @default(cuid())
  userId String
  teamId String

  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
}

model Submission {
  id          String    @id @default(cuid())
  teamId      String
  type        String
  deadline    DateTime?
  fileUrl     String?
  status      String    @default("PENDING")
  submittedAt DateTime  @default(now())

  team Team @relation(fields: [teamId], references: [id])

  submittedById String?
  submittedBy   User?   @relation("SubmissionSubmittedBy", fields: [submittedById], references: [id])

  grade Grade?
}

model Grade {
  id           String @id @default(cuid())
  submissionId String @unique

  points    Float?
  feedback  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gradedById String?
  gradedBy   User?   @relation("GradeGradedBy", fields: [gradedById], references: [id])

  submission Submission @relation(fields: [submissionId], references: [id])
}

model ScheduleItem {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  type      String
  createdAt DateTime @default(now())

  createdById String?
  createdBy   User?   @relation("ScheduleItemCreatedBy", fields: [createdById], references: [id])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  createdAt DateTime @default(now())

  createdById String?
  createdBy   User?   @relation("AnnouncementCreatedBy", fields: [createdById], references: [id])
}

model Resource {
  id        String   @id @default(cuid())
  title     String
  url       String
  category  String?
  createdAt DateTime @default(now())

  createdById String?
  createdBy   User?   @relation("ResourceCreatedBy", fields: [createdById], references: [id])
}

model HiwiActivity {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  minutes     Int      @default(0)
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HiwiTodo {
  id        String   @id @default(cuid())
  userId    String
  title     String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PdfAnnotation {
  id               String   @id @default(cuid())
  teamSpecId       String
  content          String   // JSON string storing react-pdf-highlighter annotation data
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  createdById      String
  createdBy        User     @relation(fields: [createdById], references: [id])

  teamSpecDocument TeamSpecDocument @relation(fields: [teamSpecId], references: [id], onDelete: Cascade)
}

/// Aktivitäten/Aufgaben, die ein Hiwi für Studierende anlegt
model StudentAssignment {
  id             String   @id @default(cuid())
  title          String
  description    String?  // Notizen / Aufgabenbeschreibung
  submissionType String   // z.B. "PDF", "Link", "Code", "Präsentation"
  deadline       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id])
}
